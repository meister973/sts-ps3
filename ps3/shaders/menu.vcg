/* Menu adapter: positions are transformed on the PPE, preserving libGDX's matrix order. */
void main(float4 position : POSITION, float4 color : COLOR0, float2 uv : TEXCOORD0,
          out float4 out_position : POSITION, out float4 out_color : COLOR0,
          out float2 out_uv : TEXCOORD0)
{
    out_position = position;
    out_color = color;
    out_uv = uv;
}
