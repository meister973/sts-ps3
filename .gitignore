# Anything derived from the user's copy of the game must never be committed.
game/*
!game/.gitkeep
work/
# Root-anchored so it ignores the top-level build output dir but NOT source
# packages named "build" (e.g. transpiler .../com/stsvita/build/).
/build/
out/
*.vpk
*.log

# Gradle / Java
.gradle/
transpiler/build/
backend/build/
*.class
*.jar

# Python
__pycache__/
*.pyc

# Editors
.idea/
.vscode/
*.swp
